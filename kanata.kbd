(defcfg
  process-unmapped-keys yes
)

(defsrc
  esc
  caps a s d f h j k l ; home
  lalt
)
(defvar
  tap-time 200
  hold-time 150
  hold-time-slow 200 
)


(defalias
  caps-to-esc (tap-hold 150 175 caps caps)
  esc-tilde (tap-hold 150 175 esc S-grave)

  home (tap-hold 150 175 del home)
  
  ;; Removed the (multi f24 ...) wrappers below:
  a (tap-hold $tap-time $hold-time-slow a lmet)
  s (tap-hold $tap-time $hold-time-slow s lalt)
  d (tap-hold $tap-time $hold-time d lsft)
  f (tap-hold $tap-time $hold-time f lctl)
  
  j (tap-hold $tap-time $hold-time j rctl)
  h h
  k (tap-hold $tap-time $hold-time k rsft)
  l (tap-hold $tap-time $hold-time-slow l ralt)
  ; (tap-hold $tap-time $hold-time-slow ; rmet)
  
  lalt-arrows (tap-dance 200 (lalt (layer-while-held arrows)))
)


(deflayer base
  @caps-to-esc
  @esc-tilde @a @s @d @f @h @j @k @l @; @home
  @lalt-arrows
)

(deflayer arrows
  @caps-to-esc
  @esc-tilde @a @s @d @f left down up right @; @home
  @lalt-arrows
)
